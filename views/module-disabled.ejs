<% layout = 'main'; page = ''; %>
<div class="card empty-state" style="max-width:620px;margin:3rem auto;">
  <h1>Module unavailable</h1>
  <p>The <strong><%= moduleName %></strong> module is currently disabled by an administrator.</p>
  <a class="btn btn-primary" href="<%= user?.role === 'admin' ? '/admin/modules' : '/auth/profile' %>"><%= user?.role === 'admin' ? 'Open module settings' : 'Back to profile' %></a>
</div>
