<%
  layout = 'main';
  title = 'All Leads';
  subtitle = `${typeof pagination !== 'undefined' && pagination ? pagination.total : leads.length} total leads`;
  page = 'leads';
  topbarActions = `<a href="/counsellor/leads/new" class="btn btn-primary btn-sm">+ Add Lead</a>`;
  const statusOptions = typeof leadStatuses !== 'undefined'
    ? leadStatuses
    : [
      { key: 'new', label: 'New', badgeClass: 'badge-orange' },
      { key: 'contacted', label: 'Contacted', badgeClass: 'badge-blue' },
      { key: 'mentorship_scheduled', label: 'Mentorship Scheduled', badgeClass: 'badge-blue' },
      { key: 'mentorship_attended', label: 'Mentorship Attended', badgeClass: 'badge-yellow' },
      { key: 'follow_up', label: 'Follow Up', badgeClass: 'badge-yellow' },
      { key: 'joining_interested', label: 'Joining Interested', badgeClass: 'badge-gold' },
      { key: 'admission_completed', label: 'Admission Completed', badgeClass: 'badge-green' },
      { key: 'lost', label: 'Lost', badgeClass: 'badge-red' }
    ];
  const statusLabelMap = statusOptions.reduce((map, status) => {
    map[status.key] = status.label;
    return map;
  }, {});
  const statusBadgeMap = statusOptions.reduce((map, status) => {
    map[status.key] = status.badgeClass || 'badge-grey';
    return map;
  }, {});
  const statusClosedMap = statusOptions.reduce((map, status) => {
    map[status.key] = Boolean(status.isClosed);
    return map;
  }, {});
  const currentListUrl = `/counsellor/leads?${new URLSearchParams(filters || {}).toString()}`;
%>

<style>
  /* Premium Directory Styles Inspired by Admin Students page */
  .people-toolbar { display: grid; grid-template-columns: minmax(220px, 1.2fr) repeat(3, minmax(130px, 1fr)) auto; gap: 0.75rem; align-items: end; padding: 1rem; margin-bottom: 1.25rem; }
  .people-toolbar .form-group { margin: 0; }
  
  .people-summary { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border: 1px solid var(--border); border-radius: 8px; margin-bottom: 1.25rem; overflow: hidden; }
  .people-summary-item { padding: 0.8rem 1.2rem; background: var(--bg-card); }
  .people-summary-item + .people-summary-item { border-left: 1px solid var(--border); }
  .people-summary-label { display: block; color: var(--text-muted); font-size: 0.68rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; }
  .people-summary-value { display: block; margin-top: 0.2rem; font-size: 1.25rem; font-weight: 850; }

  .people-directory { border: 1px solid var(--border); border-radius: 8px; overflow: hidden; }
  .people-directory-head, .person-directory-row { display: grid; grid-template-columns: minmax(240px, 1.35fr) minmax(180px, 1fr) minmax(210px, 1.1fr) minmax(140px, auto); gap: 1rem; align-items: center; }
  .people-directory-head { padding: 0.7rem 1rem; background: var(--bg-hover); color: var(--text-muted); font-size: 0.68rem; font-weight: 850; text-transform: uppercase; letter-spacing: 0.05em; }
  .person-directory-row { position: relative; padding: 1rem; background: var(--bg-card); border-top: 1px solid var(--border); cursor: pointer; transition: background 0.16s ease; }
  .person-directory-row:hover { background: var(--bg-hover); }
  .person-directory-row:focus-visible { outline: 2px solid var(--gold); outline-offset: -2px; }

  .person-identity { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 0.75rem; align-items: center; min-width: 0; }
  .person-avatar { width: 42px; height: 42px; border-radius: 8px; flex: 0 0 auto; background: var(--gold-dim); border: 1px solid var(--gold-border); display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 800; color: var(--gold); }
  .person-name { color: var(--text); font-size: 0.94rem; font-weight: 850; }
  .person-contact, .person-meta { color: var(--text-sub); font-size: 0.76rem; line-height: 1.45; overflow-wrap: anywhere; }
  .person-id { color: var(--gold); font: 800 0.68rem var(--mono); margin-top: 0.18rem; }

  .person-context { min-width: 0; }
  .person-context strong { display: block; margin-bottom: 0.2rem; font-size: 0.84rem; }
  .person-context span { display: block; color: var(--text-sub); font-size: 0.75rem; line-height: 1.45; }

  .person-signals { display: flex; gap: 0.35rem; align-items: center; flex-wrap: wrap; }
  .person-actions { display: flex; justify-content: flex-end; align-items: center; gap: 0.4rem; flex-wrap: wrap; }
  .lead-column-picker { position:relative; margin-bottom:.75rem; }
  .lead-column-picker > summary { list-style:none; cursor:pointer; }
  .lead-column-picker > summary::-webkit-details-marker { display:none; }
  .lead-column-panel { position:absolute; z-index:40; left:0; top:calc(100% + .5rem); width:330px; padding:1rem; border:1px solid var(--border); border-radius:10px; background:var(--bg-card); box-shadow:var(--shadow-lg); }
  .lead-column-presets { display:flex; gap:.35rem; margin:.75rem 0; }
  .lead-column-grid { display:grid; gap:.25rem; }
  .lead-column-option { display:flex; align-items:center; gap:.55rem; min-height:34px; color:var(--text-sub); font-size:.78rem; }
  #counsellorLeadTable { width:100%; min-width:max-content; }
  #counsellorLeadTable [data-lead-column][hidden] { display:none !important; }
  #counsellorLeadTable [data-lead-column="name"] { position:sticky; left:0; z-index:3; min-width:200px; background:var(--bg-card); border-right:1px solid var(--border); }
  #counsellorLeadTable [data-lead-column="phone"] { min-width:155px; white-space:nowrap; font-family:var(--mono); }
  #counsellorLeadTable [data-lead-column="simCode"] { min-width:100px; white-space:nowrap; font-family:var(--mono); }
  #counsellorLeadTable [data-lead-column="email"] { min-width:230px; }
  #counsellorLeadTable [data-lead-column="course"] { min-width:170px; }
  #counsellorLeadTable [data-lead-column="status"] { min-width:190px; }
  #counsellorLeadTable [data-lead-column="followUp"] { min-width:180px; }
  #counsellorLeadTable [data-lead-column="actions"] { position:sticky; right:0; z-index:3; min-width:120px; background:var(--bg-card); border-left:1px solid var(--border); }
  #counsellorLeadTable th[data-lead-column="name"], #counsellorLeadTable th[data-lead-column="actions"] { z-index:5; background:var(--bg-hover); }
  #counsellorLeadTable tbody tr:hover [data-lead-column="name"], #counsellorLeadTable tbody tr:hover [data-lead-column="actions"] { background:var(--bg-hover); }
  #counsellorLeadTable td { vertical-align:middle; }
  #counsellorLeadTable td[data-lead-column="status"] form,
  #counsellorLeadTable td[data-lead-column="followUp"] form { display:flex; align-items:center; min-height:40px; }
  #counsellorLeadTable td[data-lead-column="followUp"] .date-input-wrap { width:170px; flex:0 0 170px; }
  .lead-select-badge, .lead-inline-date { box-sizing:border-box; height:40px; margin:0; border:1px solid var(--gold-border); border-radius:8px; background:var(--bg-input); color:var(--text); }
  .lead-inline-sim { box-sizing:border-box; width:76px; height:40px; padding:.35rem .55rem; border:1px solid var(--gold-border); border-radius:8px; background:var(--bg-input); color:var(--text); font:800 .72rem var(--mono); text-transform:uppercase; }
  .lead-select-badge { width:180px; padding:.35rem .55rem; font-weight:700; }
  .lead-inline-date { width:100%; padding:.35rem 2.5rem .35rem .65rem; font:700 .72rem var(--mono); }

  @media (max-width: 1024px) {
    .people-directory-head { display: none; }
    .person-directory-row { grid-template-columns: minmax(220px, 1.2fr) minmax(170px, 1fr) auto; }
    .person-signals { grid-column: 2; }
    .person-actions { grid-column: 3; grid-row: 1 / span 2; }
  }
  @media (max-width: 768px) {
    .people-toolbar { grid-template-columns: 1fr; }
    .people-summary { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .people-summary-item:nth-child(n+3) { border-top: 1px solid var(--border); }
    .people-summary-item:nth-child(2n+1) { border-left: 0; }
    .person-directory-row { grid-template-columns: 1fr; gap: 0.8rem; padding: 0.9rem; }
    .person-context, .person-signals, .person-actions { grid-column: 1; grid-row: auto; }
    .person-actions { justify-content: flex-start; padding-top: 0.7rem; border-top: 1px solid var(--border); }
  }
</style>

<% if (filters.error) { %><div class="alert alert-error"><%= filters.error %></div><% } %>
<% if (filters.imported || filters.skipped || filters.failed) { %>
  <div class="alert alert-success">Import complete: <b><%= filters.imported || 0 %></b> imported, <b><%= filters.skipped || 0 %></b> duplicates skipped, <b><%= filters.failed || 0 %></b> failed.</div>
<% } %>

<details class="card" style="margin-bottom:1.25rem;">
  <summary style="padding:1rem; cursor:pointer; font-weight:800;">Import leads from CSV <span class="text-muted" style="font-weight:500;">Optional</span></summary>
  <form method="POST" action="/counsellor/leads/import" enctype="multipart/form-data" data-no-soft-nav="true" style="display:grid; gap:.85rem; padding:0 1rem 1rem;">
    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <div class="d-flex gap-1" style="justify-content:space-between; align-items:center; flex-wrap:wrap;">
      <span class="form-hint">Each imported lead is assigned to you. Unknown courses remain undecided.</span>
      <a href="/templates/lead-import-template.csv" download class="btn btn-ghost btn-sm">Download template</a>
    </div>
    <input type="file" name="leadCsv" class="form-control" accept=".csv,.tsv,.txt,text/csv,text/plain,text/tab-separated-values" required>
    <div class="form-group" style="margin:0;">
      <label class="form-label" for="counsellorImportCourse">Course for rows without a matching course</label>
      <select id="counsellorImportCourse" name="defaultCourse" class="form-control">
        <option value="">Leave undecided</option>
        <% courses.forEach(course => { %><option value="<%= course._id %>"><%= course.name %></option><% }) %>
      </select>
    </div>
    <button type="submit" class="btn btn-primary">Import leads</button>
  </form>
</details>

<!-- Directory summary cards -->
<section class="people-summary" aria-label="Leads list summary">
  <div class="people-summary-item">
    <span class="people-summary-label">Total Leads</span>
    <span class="people-summary-value"><%= typeof pagination !== 'undefined' && pagination ? pagination.total : leads.length %></span>
  </div>
  <div class="people-summary-item">
    <span class="people-summary-label">Active Pipeline</span>
    <span class="people-summary-value" style="color: var(--orange);"><%= stats.activeCount %></span>
  </div>
  <div class="people-summary-item">
    <span class="people-summary-label">Follow-ups Due</span>
    <span class="people-summary-value" style="color: <%= stats.followupDueCount > 0 ? 'var(--red)' : 'var(--text)' %>;">
      <%= stats.followupDueCount %>
    </span>
  </div>
  <div class="people-summary-item">
    <span class="people-summary-label">Converted</span>
    <span class="people-summary-value" style="color: var(--green);"><%= stats.convertedCount %></span>
  </div>
</section>

<!-- Filters -->
<form method="GET" action="/counsellor/leads" class="card people-toolbar" data-instant-filter>
  <div class="form-group" style="flex: 1;">
    <label class="form-label" style="font-size: 10px;">Search</label>
    <input type="text" name="search" class="form-control" placeholder="Name or phone..." value="<%= filters.search || '' %>" style="padding: 0.45rem 0.75rem;">
  </div>
  <div class="form-group">
    <label class="form-label" style="font-size: 10px;">Status</label>
    <select name="status" class="form-control" style="padding: 0.45rem 0.75rem;" onchange="this.form.submit()">
      <option value="">All Statuses</option>
      <% statusOptions.forEach(s => { %>
        <option value="<%= s.key %>" <%= filters.status === s.key ? 'selected' : '' %>><%= s.label %></option>
      <% }); %>
    </select>
  </div>
  <div class="form-group" style="min-width: 150px;">
    <label class="form-label" style="font-size: 10px;">Course</label>
    <select name="course" class="form-control" style="padding: 0.45rem 0.75rem;" onchange="this.form.submit()">
      <option value="">All Courses</option>
      <% courses.forEach(c => { %><option value="<%= c.name %>" <%= filters.course === c.name ? 'selected' : '' %>><%= c.name %></option><% }); %>
      <option value="Undecided" <%= filters.course === 'Undecided' ? 'selected' : '' %>>Undecided</option>
    </select>
  </div>
  <div class="form-group">
    <label class="form-label" style="font-size: 10px;">Source</label>
    <select name="source" class="form-control" style="padding: 0.45rem 0.75rem;" onchange="this.form.submit()">
      <option value="">All Sources</option>
      <% ['Walk-in','Website','Referral','Instagram','Facebook','LinkedIn','Advertisement','WhatsApp','Other'].forEach(s => { %>
        <option value="<%= s %>" <%= filters.source === s ? 'selected' : '' %>><%= s %></option>
      <% }); %>
    </select>
  </div>
  <div style="display: flex; gap: 6px; align-items: center; align-self: flex-end;">
    <a href="/counsellor/leads" class="btn btn-ghost btn-sm">Clear</a>
  </div>
</form>

<!-- Leads Directory Grid -->
<div id="results-container">
  <% if (leads.length === 0) { %>
    <div class="card empty-state">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
      <p>No leads found matching your filters.</p>
    </div>
  <% } else { %>
    <details class="lead-column-picker" id="counsellorLeadColumnPicker">
      <summary class="btn btn-ghost btn-sm">Columns (<span id="counsellorLeadVisibleCount">7</span>)</summary>
      <div class="lead-column-panel">
        <strong>Choose visible columns</strong>
        <div class="form-hint">Name and Actions always remain visible.</div>
        <div class="lead-column-presets"><button type="button" class="btn btn-ghost btn-xs" data-counsellor-column-preset="essential">Essential</button><button type="button" class="btn btn-ghost btn-xs" data-counsellor-column-preset="all">Show all</button></div>
        <div class="lead-column-grid" id="counsellorLeadColumnGrid"></div>
      </div>
    </details>
    <div class="table-wrap">
      <table id="counsellorLeadTable">
        <thead><tr><th data-lead-column="name">Name</th><th data-lead-column="phone">Phone</th><th data-lead-column="simCode">SIM Code</th><th data-lead-column="email">Email</th><th data-lead-column="course">Course</th><th data-lead-column="source">Source</th><th data-lead-column="status">Status</th><th data-lead-column="followUp">Next Follow-up</th><th data-lead-column="actions">Actions</th></tr></thead>
        <tbody>
      <% leads.forEach(lead => { %>
        <%
          const isClosedLead = Boolean(statusClosedMap[lead.status]);
          const isOverdue = lead.nextFollowUpAt && new Date(lead.nextFollowUpAt) < new Date() && !isClosedLead;
        %>
        <tr data-row-href="/counsellor/leads/<%= lead._id %>" tabindex="0">
          <td data-lead-column="name" class="td-name"><a href="/counsellor/leads/<%= lead._id %>"><%= lead.name %></a></td>
          <td data-lead-column="phone"><%= formatPhone(lead.phone) %></td>
          <td data-lead-column="simCode"><form action="/counsellor/leads/<%= lead._id %>/sim-code" method="POST" style="margin:0;"><input type="hidden" name="returnTo" value="<%= currentListUrl %>"><input class="lead-inline-sim" name="defaultSimCode" value="<%= lead.defaultSimCode || '' %>" placeholder="—" maxlength="50" autocapitalize="characters" aria-label="SIM code for <%= lead.name %>" oninput="this.value=this.value.toUpperCase()" onchange="this.form.submit()"></form></td>
          <td data-lead-column="email"><%= lead.email || '—' %></td>
          <td data-lead-column="course"><%= lead.interestedCourse ? lead.interestedCourse.name : 'Undecided' %></td>
          <td data-lead-column="source"><%= lead.source || '—' %></td>
          <td data-lead-column="status"><form action="/counsellor/leads/<%= lead._id %>/status" method="POST" style="margin:0;"><input type="hidden" name="returnTo" value="<%= currentListUrl %>"><select name="status" class="lead-select-badge" onchange="this.form.submit()" aria-label="Status for <%= lead.name %>"><% statusOptions.forEach(option => { if (option.key !== 'admission_completed' || lead.convertedStudent || lead.status === 'admission_completed') { %><option value="<%= option.key %>" <%= lead.status === option.key ? 'selected' : '' %>><%= option.label %></option><% } }) %></select></form></td>
          <td data-lead-column="followUp"><form action="/counsellor/leads/<%= lead._id %>/follow-up" method="POST" style="margin:0;"><input type="hidden" name="returnTo" value="<%= currentListUrl %>"><input type="date" name="followUpDate" class="lead-inline-date <%= isOverdue ? 'text-red' : '' %>" value="<%= lead.nextFollowUpAt ? new Date(lead.nextFollowUpAt).toISOString().slice(0,10) : '' %>" onchange="this.form.submit()" aria-label="Next follow-up for <%= lead.name %>"></form></td>
          <td data-lead-column="actions"><div class="person-actions"><a href="/counsellor/leads/<%= lead._id %>" class="btn btn-ghost btn-xs">View</a><a href="/counsellor/leads/<%= lead._id %>/edit" class="btn btn-ghost btn-xs">Edit</a></div></td>
        </tr>
      <% }); %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <% if (typeof pagination !== 'undefined' && pagination && pagination.pages > 1) { %>
      <% const pageUrl = (p) => {
        const params = new URLSearchParams(filters || {});
        params.set('page', p);
        params.set('limit', pagination.limit);
        return '?' + params.toString();
      }; %>
      <div style="display:flex; justify-content:space-between; align-items:center; gap:1rem; flex-wrap:wrap; margin-top:1.5rem; padding-top:1rem; border-top:1px solid var(--border);">
        <div class="td-muted text-sm">
          Showing page <strong><%= pagination.page %></strong> of <strong><%= pagination.pages %></strong> · <%= pagination.total %> leads
        </div>
        <div style="display:flex; gap:0.4rem; align-items:center; flex-wrap:wrap;">
          <a class="btn btn-ghost btn-sm <%= pagination.page <= 1 ? 'disabled' : '' %>" href="<%= pagination.page <= 1 ? '#' : pageUrl(pagination.page - 1) %>">Previous</a>
          <% for (let p = Math.max(1, pagination.page - 2); p <= Math.min(pagination.pages, pagination.page + 2); p++) { %>
            <a class="btn btn-sm <%= p === pagination.page ? 'btn-primary' : 'btn-ghost' %>" href="<%= pageUrl(p) %>"><%= p %></a>
          <% } %>
          <a class="btn btn-ghost btn-sm <%= pagination.page >= pagination.pages ? 'disabled' : '' %>" href="<%= pagination.page >= pagination.pages ? '#' : pageUrl(pagination.page + 1) %>">Next</a>
        </div>
      </div>
    <% } %>
  <% } %>
</div>

<script src="/js/instant-filter.js"></script>
<script>
  function initCounsellorLeadColumns() {
    const table = document.getElementById('counsellorLeadTable');
    const grid = document.getElementById('counsellorLeadColumnGrid');
    const count = document.getElementById('counsellorLeadVisibleCount');
    if (!table || !grid || grid.dataset.ready) return;
    const columns = [...table.querySelectorAll('thead [data-lead-column]')].map(cell => ({ key: cell.dataset.leadColumn, label: cell.textContent.trim() }));
    const locked = new Set(['name', 'actions']);
    const presets = { essential: ['name', 'phone', 'simCode', 'course', 'status', 'followUp', 'actions'], all: columns.map(column => column.key) };
    let saved;
    try { saved = JSON.parse(localStorage.getItem('vande.counsellorLeadColumns.v1')); } catch (_) { saved = null; }
    let visible = new Set(Array.isArray(saved) ? saved : presets.essential);
    locked.forEach(key => visible.add(key));
    const apply = () => {
      columns.forEach(column => {
        table.querySelectorAll(`[data-lead-column="${column.key}"]`).forEach(cell => { cell.hidden = !visible.has(column.key); });
        const input = grid.querySelector(`[data-column-key="${column.key}"]`);
        if (input) input.checked = visible.has(column.key);
      });
      count.textContent = visible.size;
      localStorage.setItem('vande.counsellorLeadColumns.v1', JSON.stringify([...visible]));
    };
    columns.forEach(column => {
      const label = document.createElement('label');
      label.className = 'lead-column-option';
      const input = document.createElement('input');
      input.type = 'checkbox';
      input.dataset.columnKey = column.key;
      input.disabled = locked.has(column.key);
      input.addEventListener('change', () => { input.checked ? visible.add(column.key) : visible.delete(column.key); apply(); });
      label.append(input, document.createTextNode(column.label));
      grid.appendChild(label);
    });
    document.querySelectorAll('[data-counsellor-column-preset]').forEach(button => button.addEventListener('click', () => {
      visible = new Set(presets[button.dataset.counsellorColumnPreset]);
      apply();
    }));
    grid.dataset.ready = '1';
    apply();
  }

  function initLeadRowClicks() {
    document.querySelectorAll('[data-row-href]').forEach(row => {
      if (row.dataset.rowReady) return;
      const open = event => {
        if (event.target.closest('a, button, input, select, textarea, form, label')) return;
        if (window.AppSoftNav && typeof window.AppSoftNav.navigateTo === 'function') {
          window.AppSoftNav.navigateTo(row.dataset.rowHref);
        } else {
          window.location.href = row.dataset.rowHref;
        }
      };
      row.addEventListener('click', open);
      row.dataset.rowReady = 'true';
      row.style.cursor = 'pointer';
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => { initCounsellorLeadColumns(); initLeadRowClicks(); });
  } else {
    initCounsellorLeadColumns();
    initLeadRowClicks();
  }

  document.addEventListener('softnav:load', () => { initCounsellorLeadColumns(); initLeadRowClicks(); });
  document.addEventListener('resultsUpdated', () => { initCounsellorLeadColumns(); initLeadRowClicks(); });
</script>
