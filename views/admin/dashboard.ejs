<%
  layout = 'main';
  title = 'Admin Dashboard';
  subtitle = 'Overview of Academy operations';
  page = 'dashboard';
%>

<!-- Greeting Header -->
<div style="display:flex; align-items:flex-end; justify-content:space-between; gap:1rem; flex-wrap:wrap; margin-bottom:1.25rem;">
  <div>
    <p class="student-kicker" style="margin-bottom:0.35rem;">Academy operations</p>
    <h2 id="dashboardGreeting" class="dashboard-greeting" style="margin:0;">Welcome back!</h2>
  </div>
  <div class="d-flex gap-1" style="flex-wrap:wrap;">
    <% if (modules?.students !== false) { %>
    <a href="/admin/users/create?role=student" class="btn btn-primary btn-sm">Add student</a>
    <% } %>
    <% if (modules?.fees !== false) { %><a href="/admin/fees" class="btn btn-ghost btn-sm">Record payment</a><% } %>
    <% if (modules?.schedules !== false) { %><a href="/admin/schedules" class="btn btn-ghost btn-sm">Plan classes</a><% } %>
    <details class="dashboard-settings">
      <summary class="btn btn-ghost btn-sm">Customize dashboard</summary>
      <div class="dashboard-settings-menu">
        <strong>Visible sections</strong>
        <label><input type="checkbox" value="pipeline" checked> Lead pipeline</label>
        <label><input type="checkbox" value="ledgers" checked> Student &amp; fee status</label>
        <label><input type="checkbox" value="today" checked> Today's operations</label>
      </div>
    </details>
  </div>
</div>

<% if (modules?.leads !== false) { %>
<div class="card" data-dashboard-section="pipeline" style="margin-bottom:1.5rem;">
  <div class="card-header">
    <div>
      <div class="card-title">Lead Pipeline</div>
      <p class="td-muted text-sm">Open the exact working queue without rebuilding filters.</p>
    </div>
    <a href="/admin/leads/create" class="btn btn-primary btn-sm">+ Add lead manually</a>
  </div>
  <div class="stats-grid" style="padding:1.25rem; margin-bottom:0;">
    <a href="/admin/leads?status=high_potential" class="stat-card gold"><div class="stat-label">High Potential</div><div class="stat-value"><%= stats.highPotentialLeads %></div><div class="stat-sub">Priority opportunities</div></a>
    <a href="/admin/leads?status=new" class="stat-card orange"><div class="stat-label">New</div><div class="stat-value"><%= stats.newLeads %></div><div class="stat-sub">Not contacted yet</div></a>
    <a href="/admin/leads?status=in_the_loop" class="stat-card blue"><div class="stat-label">In the Loop</div><div class="stat-value"><%= stats.loopLeads %></div><div class="stat-sub">Active follow-up queue</div></a>
    <a href="/admin/leads?status=admission_completed" class="stat-card green"><div class="stat-label">Converted</div><div class="stat-value"><%= stats.convertedLeads %></div><div class="stat-sub">Admission completed</div></a>
  </div>
</div>
<% } %>

<% if (modules?.fees !== false || modules?.students !== false) { %>
<div class="stats-grid" data-dashboard-section="ledgers" style="margin-bottom:1.5rem;">
  <% if (modules?.students !== false) { %>
  <a href="/admin/students?status=complete" class="stat-card green"><div class="stat-label">Completed Students</div><div class="stat-value"><%= stats.completedStudents %></div><div class="stat-sub">Finished course records</div></a>
  <% } %>
  <% if (modules?.fees !== false) { %>
  <a href="/admin/fees?paymentStatus=completed" class="stat-card green"><div class="stat-label">Completed Ledgers</div><div class="stat-value"><%= stats.feeStats.completed %></div><div class="stat-sub">No balance remaining</div></a>
  <a href="/admin/fees?paymentStatus=overdue" class="stat-card red"><div class="stat-label">Overdue Ledgers</div><div class="stat-value"><%= stats.feeStats.overdue %></div><div class="stat-sub">Action required</div></a>
  <a href="/admin/fees?paymentStatus=partially_paid" class="stat-card gold"><div class="stat-label">Partial Ledgers</div><div class="stat-value"><%= stats.feeStats.partial %></div><div class="stat-sub">Payment in progress</div></a>
  <% } %>
</div>
<% } %>

<!-- Stats Grid -->
<div class="stats-grid" data-dashboard-section="today">
  <% if (modules?.fees !== false) { %>
  <a href="/admin/fees" class="stat-card gold">
    <div class="stat-label">Today's Fee Collections</div>
    <div class="stat-value">₹<%= stats.todayCollections.toLocaleString('en-IN') %></div>
    <div class="stat-sub">Payments collected today</div>
  </a>
  <% } %>
  <% if (modules?.schedules !== false) { %>
  <a href="/admin/schedules" class="stat-card blue">
    <div class="stat-label">Today's Scheduled Classes</div>
    <div class="stat-value"><%= stats.todayCompletedCount %> / <%= stats.todayScheduledCount %></div>
    <div class="stat-sub">Completed / Total scheduled</div>
  </a>
  <% } %>
  <% if (modules?.leads !== false) { %>
  <a href="/admin/leads?status=joining_interested" class="stat-card orange">
    <div class="stat-label">Leads Ready to Convert</div>
    <div class="stat-value"><%= stats.readyLeadsCount %></div>
    <div class="stat-sub">Converted status pending</div>
  </a>
  <% } %>
  <% if (modules?.students !== false && modules?.attendance !== false) { %>
  <a href="/admin/students?attendance=low" class="stat-card red">
    <div class="stat-label">At-Risk Students</div>
    <div class="stat-value"><%= stats.atRiskCount %></div>
    <div class="stat-sub">Attendance below 75%</div>
  </a>
  <% } %>
  <% if (modules?.leaves !== false) { %>
  <a href="/admin/holidays-leaves" class="stat-card purple">
    <div class="stat-label">Pending Leave Requests</div>
    <div class="stat-value"><%= stats.pendingLeavesCount %></div>
    <div class="stat-sub">Awaiting admin approval</div>
  </a>
  <% } %>
  <% if (modules?.students !== false && modules?.assignments !== false) { %>
  <a href="/admin/students" class="stat-card green">
    <div class="stat-label">Ungraded Submissions</div>
    <div class="stat-value"><%= stats.ungradedSubmissionsCount %></div>
    <div class="stat-sub">Awaiting marks evaluation</div>
  </a>
  <% } %>
</div>

<!-- Password Reset Requests -->
<% if (typeof resetRequests !== 'undefined' && resetRequests && resetRequests.length > 0) { %>
<div class="card" style="margin-bottom: 1.5rem; border-color: var(--gold-border); background: linear-gradient(180deg, rgba(255,204,0,0.03) 0%, rgba(0,0,0,0) 100%);">
  <div class="card-header card-header--divided">
    <div class="card-title" style="color: var(--gold);">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      Pending Password Reset Requests
    </div>
    <span class="badge badge-gold"><%= resetRequests.length %> requested</span>
  </div>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>User</th>
          <th>Role</th>
          <th>Phone</th>
          <th class="td-actions">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% resetRequests.forEach(reqUser => { %>
          <tr data-reset-request-row="<%= reqUser._id %>">
            <td>
              <div class="td-name"><%= reqUser.name %></div>
              <div class="td-muted text-sm"><%= reqUser.email %></div>
            </td>
            <td>
              <span class="badge <%= reqUser.role === 'admin' ? 'badge-gold' : reqUser.role === 'teacher' ? 'badge-blue' : reqUser.role === 'counsellor' ? 'badge-orange' : 'badge-grey' %>">
                <%= reqUser.role %>
              </span>
            </td>
            <td class="mono text-sm"><%= reqUser.phone || '—' %></td>
            <td class="td-actions">
              <div class="d-flex gap-1">
                <button
                  type="button"
                  class="btn btn-primary btn-sm reset-password-btn"
                  data-user-id="<%= reqUser._id %>"
                  data-user-name="<%= reqUser.name %>"
                  data-user-phone="<%= reqUser.phone || '' %>">
                  Reset Password
                </button>
                <form action="/admin/users/<%= reqUser._id %>/dismiss-reset" method="POST" class="form-inline">
                  <input type="hidden" name="redirect" value="/admin/dashboard?updated=1">
                  <button type="submit" class="btn btn-ghost btn-sm">
                    Dismiss
                  </button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<% } %>

<!-- Recent Leads -->
<div class="card" style="margin-bottom:1.5rem;">
  <div class="card-header">
    <div>
      <div class="card-title">Recent Leads</div>
      <div class="card-sub">Created in the last 72 hours, newest first &middot; 10 shown at a time</div>
    </div>
    <a href="/admin/leads" class="btn btn-ghost btn-sm">All Leads</a>
  </div>

  <% if (recentLeads.length === 0) { %>
    <div class="empty-state"><p>No leads were added in the last 72 hours.</p></div>
  <% } else { %>
    <div id="adminRecentLeadFilters" style="display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:.75rem; margin-bottom:1rem;">
      <input id="adminRecentLeadSearch" type="search" class="form-control" placeholder="Search name or phone">
      <select id="adminRecentLeadCourse" class="form-control">
        <option value="">All courses</option>
        <% [...new Set(recentLeads.map(lead => lead.interestedCourse?.name || 'Undecided'))].sort().forEach(course => { %>
          <option value="<%= course.toLowerCase() %>"><%= course %></option>
        <% }); %>
      </select>
      <select id="adminRecentLeadSource" class="form-control">
        <option value="">All sources</option>
        <% [...new Set(recentLeads.map(lead => lead.source || 'Unknown'))].sort().forEach(source => { %>
          <option value="<%= source.toLowerCase() %>"><%= source %></option>
        <% }); %>
      </select>
      <select id="adminRecentLeadStatus" class="form-control">
        <option value="">All statuses</option>
        <% [...new Set(recentLeads.map(lead => lead.status))].sort().forEach(status => { %>
          <option value="<%= status.toLowerCase() %>"><%= status.replace(/_/g, ' ') %></option>
        <% }); %>
      </select>
    </div>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Name</th>
            <th>Phone</th>
            <th>Course</th>
            <th>Source</th>
            <th>Status</th>
            <th>Counsellor</th>
            <th>Added</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody id="adminRecentLeadRows">
          <% recentLeads.forEach(lead => { %>
            <tr data-search="<%= `${lead.name} ${lead.phone}`.toLowerCase() %>"
                data-course="<%= (lead.interestedCourse?.name || 'Undecided').toLowerCase() %>"
                data-source="<%= (lead.source || 'Unknown').toLowerCase() %>"
                data-status="<%= lead.status.toLowerCase() %>">
              <td class="td-name"><%= lead.name %></td>
              <td class="mono text-sm"><%= lead.phone %></td>
              <td><span class="badge badge-orange"><%= lead.interestedCourse?.name || 'Undecided' %></span></td>
              <td><%= lead.source || 'Unknown' %></td>
              <td><span class="badge badge-grey"><%= lead.status.replace(/_/g, ' ') %></span></td>
              <td><%= lead.assignedTo?.user?.name || 'Unassigned' %></td>
              <td class="mono text-sm"><%= new Date(lead.createdAt).toLocaleDateString('en-IN', {day:'numeric', month:'short'}) %></td>
              <td><a href="/admin/leads/<%= lead._id %>" class="btn btn-ghost btn-xs">View</a></td>
            </tr>
          <% }); %>
          <tr id="adminRecentLeadEmpty" style="display:none;"><td colspan="8" class="td-muted" style="text-align:center;">No recent leads match these filters.</td></tr>
        </tbody>
      </table>
    </div>
    <div style="display:flex; justify-content:center; margin-top:1rem;">
      <button id="adminRecentLeadLoadMore" type="button" class="btn btn-ghost btn-sm" style="display:none;">Load More</button>
    </div>
  <% } %>
</div>

<div class="grid-2">
  <!-- Recent Students -->
  <div class="card">
    <div class="card-header">
      <div class="card-title">Recent Admissions</div>
      <a href="/admin/users?role=student" class="btn btn-ghost btn-sm">All Students</a>
    </div>
    
    <% if (recentStudents.length === 0) { %>
      <div class="empty-state">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
        <p>No student admissions yet.</p>
      </div>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Name</th>
              <th>Course</th>
              <th>Batch</th>
            </tr>
          </thead>
          <tbody>
            <% recentStudents.forEach(student => { %>
              <tr style="cursor:pointer;" onclick="if(window.AppSoftNav){window.AppSoftNav.navigateTo('/admin/students/<%= student._id %>')}else{window.location.href='/admin/students/<%= student._id %>'}">
                <td class="td-name">
                  <%= student.user && student.user.name ? student.user.name : 'Unknown Student' %>
                  <div class="td-muted text-xs mono"><%= student.rollNumber || 'ID not generated' %></div>
                </td>
                <td><span class="badge badge-orange"><%= student.course && student.course.name ? student.course.name : '—' %></span></td>
                <td class="td-muted"><%= student.batch && student.batch.name ? student.batch.name : '—' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <!-- Hot Leads -->
  <div class="card">
    <div class="card-header">
      <div class="card-title">Leads requiring Follow-up</div>
      <a href="/admin/leads" class="btn btn-ghost btn-sm">All Leads</a>
    </div>
    
    <% if (hotLeads.length === 0) { %>
      <div class="empty-state">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/></svg>
        <p>No active follow-ups due.</p>
      </div>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Name</th>
              <th>Assigned To</th>
              <th>Follow-up</th>
            </tr>
          </thead>
          <tbody>
            <% hotLeads.forEach(lead => { %>
              <% const isOverdue = lead.followUpDate && new Date(lead.followUpDate) < new Date(); %>
              <tr>
                <td class="td-name">
                  <div><%= lead.name %></div>
                  <div class="td-muted text-sm" style="font-family: monospace;"><%= lead.phone %></div>
                </td>
                <td><%= lead.assignedTo ? lead.assignedTo.name : 'Unassigned' %></td>
                <td <%= isOverdue ? 'style="color: var(--red); font-weight: bold;"' : '' %>>
                  <%= lead.followUpDate ? new Date(lead.followUpDate).toLocaleDateString('en-IN', {day:'numeric',month:'short'}) : '—' %>
                  <%= isOverdue ? '⚠️' : '' %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<script>
  function initDashboardSettings() {
    const settings = document.querySelector('.dashboard-settings');
    if (!settings || settings.dataset.ready) return;
    const key = 'admin-dashboard-sections:<%= user._id %>';
    let visible;
    try { visible = new Set(JSON.parse(localStorage.getItem(key) || '["pipeline","ledgers","today"]')); }
    catch (_) { visible = new Set(['pipeline', 'ledgers', 'today']); }
    const apply = () => {
      settings.querySelectorAll('input').forEach(input => {
        input.checked = visible.has(input.value);
        document.querySelectorAll(`[data-dashboard-section="${input.value}"]`).forEach(section => {
          section.hidden = !input.checked;
        });
      });
    };
    settings.addEventListener('change', event => {
      if (!event.target.matches('input')) return;
      event.target.checked ? visible.add(event.target.value) : visible.delete(event.target.value);
      localStorage.setItem(key, JSON.stringify([...visible]));
      apply();
    });
    apply();
    settings.dataset.ready = 'true';
  }

  function initAdminRecentLeads() {
    const filters = document.getElementById('adminRecentLeadFilters');
    if (!filters || filters.dataset.ready) return;
    const rows = [...document.querySelectorAll('#adminRecentLeadRows tr[data-search]')];
    const empty = document.getElementById('adminRecentLeadEmpty');
    const loadMore = document.getElementById('adminRecentLeadLoadMore');
    let limit = 10;
    const apply = () => {
      const search = document.getElementById('adminRecentLeadSearch').value.trim().toLowerCase();
      const course = document.getElementById('adminRecentLeadCourse').value;
      const source = document.getElementById('adminRecentLeadSource').value;
      const status = document.getElementById('adminRecentLeadStatus').value;
      const matches = rows.filter(row => (
        (!search || row.dataset.search.includes(search))
        && (!course || row.dataset.course === course)
        && (!source || row.dataset.source === source)
        && (!status || row.dataset.status === status)
      ));
      rows.forEach(row => { row.style.display = 'none'; });
      matches.slice(0, limit).forEach(row => { row.style.display = ''; });
      empty.style.display = matches.length ? 'none' : '';
      loadMore.style.display = matches.length > limit ? '' : 'none';
    };
    const resetAndApply = () => {
      limit = 10;
      apply();
    };
    loadMore.addEventListener('click', () => {
      limit += 10;
      apply();
    });
    filters.addEventListener('input', resetAndApply);
    filters.addEventListener('change', resetAndApply);
    // ponytail: client-side paging fits a 72-hour dashboard window; move to an endpoint if import volume makes it heavy.
    apply();
    filters.dataset.ready = 'true';
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDashboardSettings);
    document.addEventListener('DOMContentLoaded', initAdminRecentLeads);
  } else {
    initDashboardSettings();
    initAdminRecentLeads();
  }
  document.addEventListener('softnav:load', initDashboardSettings);
  document.addEventListener('softnav:load', initAdminRecentLeads);
</script>

<%- include('../partials/admin-password-reset-modal', { passwordResetRedirect: '/admin/dashboard' }) %>
