<%
  layout = 'main';
  title = 'Module Settings';
  page = 'module-settings';
  const labels = {
    students: ['Students', 'Student records and student portal only'],
    teachers: ['Teachers', 'Teacher records and teacher portal only'],
    counsellors: ['Counsellors', 'Counsellor records and counsellor portal only'],
    courses: ['Courses', 'Course catalogue management only'],
    batches: ['Batches', 'Batch creation and assignment only'],
    attendance: ['Attendance', 'Attendance screens across all portals only'],
    kyc: ['KYC', 'Identity verification only; the student portal remains available'],
    leads: ['Lead Pipeline', 'Lead capture, follow-ups, assignment, and conversion'],
    fees: ['Fees & Ledger', 'Fee setup, payments, invoices, and student fee views'],
    schedules: ['Class Schedules', 'Sessions, timetables, and classroom planning'],
    assignments: ['Assignments', 'Teacher assignment and student submission screens'],
    updates: ['Daily Updates', 'Teacher updates and student update feed'],
    curriculum: ['Curriculum', 'Curriculum tracking and student curriculum view'],
    progress: ['Student Progress', 'Tests, remarks, progress, and certificates'],
    announcements: ['Announcements', 'Announcements and shared learning materials'],
    reports: ['Reports & Analytics', 'Admin, counsellor, and student analytics'],
    leaves: ['Holidays & Leaves', 'Holiday calendar and staff leave requests']
  };
%>

<% if (filter?.saved || success?.length) { %><div class="alert alert-toast alert-success">Module settings saved.</div><% } %>

<div class="card" style="max-width:820px;margin:0 auto;">
  <div class="card-header">
    <div><div class="card-title">Enable academy modules</div><div class="card-sub">Every switch is independent. Turning one off removes only that feature and its direct inputs.</div></div>
  </div>
  <form method="POST" action="/admin/modules" data-native-submit="true">
    <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>">
    <div style="display:grid;gap:.75rem;">
      <% moduleKeys.forEach(key => { %>
        <label style="display:flex;align-items:center;gap:1rem;padding:1rem;border:1px solid var(--border);border-radius:var(--radius);background:var(--bg-input);cursor:pointer;">
          <input type="checkbox" name="<%= key %>" style="width:20px;height:20px;accent-color:var(--gold);" <%= modules[key] ? 'checked' : '' %>>
          <span style="flex:1;"><strong style="display:block;"><%= labels[key][0] %></strong><small class="text-muted"><%= labels[key][1] %></small></span>
          <span class="badge <%= modules[key] ? 'badge-green' : 'badge-grey' %>"><%= modules[key] ? 'Enabled' : 'Disabled' %></span>
        </label>
      <% }) %>
    </div>
    <div style="display:flex;justify-content:flex-end;margin-top:1rem;"><button class="btn btn-primary" type="submit">Save module settings</button></div>
  </form>
</div>
