</aside>
<style>
  .nav-flyout{position:relative}
  .nav-flyout-arrow{margin-left:auto;font-size:1rem;color:var(--text-muted);transition:transform .18s ease}
  .nav-flyout-menu{display:none;gap:.15rem;margin:.25rem .7rem .55rem 2.55rem;padding:.4rem;max-height:min(70vh,24rem);overflow-y:auto;background:var(--bg-card);border:1px solid var(--border);border-radius:10px}
  .nav-flyout:hover .nav-flyout-menu,.nav-flyout:focus-within .nav-flyout-menu{display:grid}
  .nav-flyout:hover .nav-flyout-arrow,.nav-flyout:focus-within .nav-flyout-arrow{transform:rotate(90deg);color:var(--gold)}
  .nav-flyout-menu a{padding:.55rem .65rem;color:var(--text-sub);border-radius:7px;font-size:.78rem;font-weight:650;white-space:nowrap}
  .nav-flyout-menu a:hover,.nav-flyout-menu a:focus{color:var(--gold);background:var(--gold-dim);outline:none}
  .nav-flyout-menu .nav-flyout-action{margin-bottom:.15rem;color:var(--gold);background:var(--gold-dim);border:1px solid var(--gold-border);font-weight:750}
  .sbc-backdrop{position:fixed;inset:0;z-index:9997;background:rgba(10,10,10,.58);backdrop-filter:blur(5px);opacity:0;visibility:hidden;pointer-events:none;transition:opacity .22s ease,visibility .22s ease}
  .sbc-backdrop.open{opacity:1;visibility:visible;pointer-events:auto}
  .sbc-drawer{position:fixed;top:0;right:0;bottom:0;z-index:9998;display:flex;flex-direction:column;width:min(470px,100vw);color:var(--text,#161616);background:radial-gradient(circle at 100% 0,rgba(255,204,0,.16),transparent 30%),var(--bg-card,#fff);border-left:1px solid var(--gold-border,rgba(180,140,0,.3));box-shadow:-28px 0 80px rgba(0,0,0,.28);transform:translateX(105%);transition:transform .28s cubic-bezier(.22,1,.36,1)}
  .sbc-drawer.open{transform:translateX(0)}
  .sbc-head{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;padding:1.5rem;border-bottom:1px solid var(--border,#e8dfc5)}
  .sbc-kicker{display:block;margin-bottom:.25rem;color:var(--gold,#b99100);font-size:.64rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase}
  .sbc-head h2{margin:0;font-family:var(--font-display,inherit);font-size:1.35rem;letter-spacing:-.03em}
  .sbc-head p{margin:.35rem 0 0;color:var(--text-sub,#666);font-size:.8rem}
  .sbc-close{width:38px;height:38px;flex:0 0 auto;color:var(--text-sub,#666);background:var(--bg-input,#f5f1e7);border:1px solid var(--border,#e8dfc5);border-radius:50%;cursor:pointer}
  .sbc-summary{display:grid;grid-template-columns:1fr 1fr;gap:.75rem;padding:1rem 1.5rem 0}
  .sbc-stat{display:flex;align-items:baseline;gap:.5rem;padding:.8rem 1rem;background:var(--bg-input,#f8f5ed);border:1px solid var(--border,#e8dfc5);border-radius:10px}
  .sbc-stat strong{color:var(--gold,#b99100);font-family:var(--font-display,inherit);font-size:1.25rem}
  .sbc-stat span{color:var(--text-muted,#777);font-size:.66rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase}
  .sbc-tools{padding:1rem 1.5rem}
  .sbc-search{width:100%;padding:.72rem .85rem;color:var(--text,#161616);background:var(--bg-input,#f8f5ed);border:1px solid var(--border,#e8dfc5);border-radius:9px;outline:none}
  .sbc-search:focus{border-color:var(--gold,#b99100);box-shadow:0 0 0 3px var(--gold-dim,rgba(180,140,0,.12))}
  .sbc-quick{display:flex;gap:1rem;margin-top:.65rem}
  .sbc-quick button{padding:0;color:var(--gold,#b99100);background:none;border:0;font-size:.72rem;font-weight:750;cursor:pointer}
  .sbc-options{flex:1;padding:0 1.5rem 1rem;overflow-y:auto}
  .sbc-group+.sbc-group{margin-top:1.15rem}
  .sbc-group-title{margin:0 0 .5rem;color:var(--text-muted,#777);font-size:.63rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}
  .sbc-grid{display:grid;gap:.55rem}
  .sbc-option{display:flex;align-items:center;gap:.8rem;padding:.75rem .85rem;background:var(--bg-input,#f8f5ed);border:1px solid var(--border,#e8dfc5);border-radius:10px;cursor:pointer;transition:transform .14s ease,border-color .14s ease,background .14s ease}
  .sbc-option:hover{transform:translateX(-3px);border-color:var(--border-light,#d8cba8)}
  .sbc-option.dragging{opacity:.45}
  .sbc-option.drag-over{border-color:var(--gold,#b99100);box-shadow:0 -3px 0 var(--gold,#b99100)}
  .sbc-option.selected{border-color:var(--gold-border,rgba(180,140,0,.35));background:var(--gold-dim,rgba(180,140,0,.1))}
  .sbc-item-icon{display:grid;place-items:center;width:36px;height:36px;flex:0 0 auto;color:var(--gold,#b99100);background:rgba(255,204,0,.1);border:1px solid var(--gold-border,rgba(180,140,0,.3));border-radius:9px;font-size:.72rem;font-weight:850}
  .sbc-item-icon svg{width:18px;height:18px;stroke:currentColor}
  .sbc-copy{min-width:0;flex:1}
  .sbc-name-input,.sbc-group-name{width:100%;color:var(--text,#161616);background:transparent;border:0;border-bottom:1px solid transparent;outline:none}
  .sbc-name-input{display:block;padding:.15rem 0;font-size:.83rem;font-weight:750}
  .sbc-group-name{padding:.2rem 0 .35rem;color:var(--text-muted,#777);font-size:.68rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}
  .sbc-name-input:focus,.sbc-group-name:focus{border-bottom-color:var(--gold,#b99100)}
  .sbc-copy small{display:block;overflow:hidden;color:var(--text-muted,#777);font-size:.64rem;text-overflow:ellipsis;white-space:nowrap}
  .sbc-order{display:flex;gap:.25rem}
  .sbc-order button{width:27px;height:27px;padding:0;color:var(--text-muted,#777);background:transparent;border:1px solid var(--border,#e8dfc5);border-radius:6px;cursor:pointer}
  .sbc-order button:hover{color:var(--gold,#b99100);border-color:var(--gold-border,rgba(180,140,0,.35))}
  .sbc-option input[type="checkbox"]{position:absolute!important;width:1px!important;height:1px!important;opacity:0!important;pointer-events:none}
  .sbc-switch{position:relative;width:40px;height:23px;flex:0 0 auto;background:var(--border-light,#d8d1bf);border-radius:999px;transition:background .18s ease}
  .sbc-switch:after{content:'';position:absolute;top:3px;left:3px;width:17px;height:17px;background:#fff;border-radius:50%;box-shadow:0 2px 5px rgba(0,0,0,.25);transition:transform .18s ease}
  .sbc-option input[type="checkbox"]:checked+.sbc-switch{background:var(--gold,#d1a900)}
  .sbc-option input[type="checkbox"]:checked+.sbc-switch:after{transform:translateX(17px)}
  .sbc-actions{display:grid;grid-template-columns:.8fr 1.2fr;gap:.75rem;padding:1rem 1.5rem;background:var(--bg-card,#fff);border-top:1px solid var(--border,#e8dfc5);box-shadow:0 -12px 30px rgba(0,0,0,.08)}
  .sbc-actions button{min-height:42px}
  body.sbc-lock{overflow:hidden}
  @media(max-width:520px){.sbc-head{padding:1.1rem}.sbc-summary,.sbc-tools,.sbc-options,.sbc-actions{padding-left:1rem;padding-right:1rem}}
</style>

<div id="sbcBackdrop" class="sbc-backdrop" aria-hidden="true"></div>
<section id="sbcDrawer" class="sbc-drawer" role="dialog" aria-modal="true" aria-labelledby="sbcTitle" aria-hidden="true">
  <header class="sbc-head">
    <div><span class="sbc-kicker">Personal workspace</span><h2 id="sbcTitle">Shape your sidebar</h2><p>Show, hide, or drag tools into your preferred order.</p></div>
    <button id="sbcClose" class="sbc-close" type="button" aria-label="Close">&times;</button>
  </header>
  <div class="sbc-summary">
    <div class="sbc-stat"><strong id="sbcVisibleCount">0</strong><span>Visible</span></div>
    <div class="sbc-stat"><strong id="sbcHiddenCount">0</strong><span>Hidden</span></div>
  </div>
  <div class="sbc-tools">
    <input id="sbcSearch" class="sbc-search" type="search" placeholder="Search menu items...">
    <div class="sbc-quick"><button id="sbcShowAll" type="button">Show all</button><button id="sbcHideAll" type="button">Hide all</button></div>
  </div>
  <div id="sbcOptions" class="sbc-options"></div>
  <footer class="sbc-actions">
    <button id="sbcCancel" type="button" class="btn btn-ghost">Cancel</button>
    <button id="sbcSave" type="button" class="btn btn-primary">Save workspace</button>
  </footer>
</section>

<script>
(() => {
  const sidebar = document.querySelector('.sidebar');
  const trigger = document.getElementById('customizeSidebarBtn');
  const drawer = document.getElementById('sbcDrawer');
  const backdrop = document.getElementById('sbcBackdrop');
  const options = document.getElementById('sbcOptions');
  const search = document.getElementById('sbcSearch');
  const visibleCount = document.getElementById('sbcVisibleCount');
  const hiddenCount = document.getElementById('sbcHiddenCount');
  const storageKey = 'sidebar-hidden:<%= user._id %>';
  const orderKey = 'sidebar-order:<%= user._id %>';
  const renameKey = 'sidebar-names:<%= user._id %>';
  const items = [...sidebar.querySelectorAll('a.nav-item')];
  const labels = [...sidebar.querySelectorAll('.nav-label')];
  items.forEach(item => { item.dataset.defaultName = item.querySelector('span').textContent.trim(); });
  labels.forEach(label => { label.dataset.defaultName = label.textContent.trim(); });
  let hidden;
  let savedOrder;
  let savedNames;
  try { hidden = new Set(JSON.parse(localStorage.getItem(storageKey) || '[]')); }
  catch (_) { hidden = new Set(); }
  try { savedOrder = JSON.parse(localStorage.getItem(orderKey) || '[]'); }
  catch (_) { savedOrder = []; }
  try { savedNames = JSON.parse(localStorage.getItem(renameKey) || '{"items":{},"groups":{}}'); }
  catch (_) { savedNames = { items: {}, groups: {} }; }

  const applyNames = () => {
    items.forEach(item => { item.querySelector('span').textContent = savedNames.items?.[item.getAttribute('href')] || item.dataset.defaultName; });
    labels.forEach(label => { label.textContent = savedNames.groups?.[label.dataset.defaultName] || label.dataset.defaultName; });
  };

  const itemContainer = item => item.closest('.nav-flyout') || item;
  const applyOrder = () => {
    const rank = new Map(savedOrder.map((path, index) => [path, index]));
    sidebar.querySelectorAll('.nav-label').forEach(label => {
      const group = [];
      let node = label.nextElementSibling;
      while (node && !node.classList.contains('nav-label')) {
        if (node.matches('a.nav-item, .nav-flyout')) group.push(node);
        node = node.nextElementSibling;
      }
      const boundary = node;
      group.sort((a, b) => {
        const aPath = (a.matches('a') ? a : a.querySelector('a.nav-item'))?.getAttribute('href');
        const bPath = (b.matches('a') ? b : b.querySelector('a.nav-item'))?.getAttribute('href');
        return (rank.get(aPath) ?? Number.MAX_SAFE_INTEGER) - (rank.get(bPath) ?? Number.MAX_SAFE_INTEGER);
      }).forEach(entry => label.parentElement.insertBefore(entry, boundary));
    });
    items.sort((a, b) => (rank.get(a.getAttribute('href')) ?? Number.MAX_SAFE_INTEGER) - (rank.get(b.getAttribute('href')) ?? Number.MAX_SAFE_INTEGER));
  };

  const applySaved = () => {
    applyNames();
    applyOrder();
    items.forEach(item => {
      const isHidden = hidden.has(item.getAttribute('href'));
      const container = itemContainer(item);
      container.hidden = isHidden;
      if (isHidden) container.style.setProperty('display', 'none', 'important');
      else container.style.removeProperty('display');
    });
    sidebar.querySelectorAll('.nav-label').forEach(label => {
      let sibling = label.nextElementSibling;
      let visible = false;
      while (sibling && !sibling.classList.contains('nav-label')) {
        const navItem = sibling.matches('a.nav-item') ? sibling : sibling.querySelector?.('a.nav-item');
        if (navItem && !hidden.has(navItem.getAttribute('href'))) visible = true;
        sibling = sibling.nextElementSibling;
      }
      label.style.display = visible ? '' : 'none';
    });
  };
  const groupFor = item => {
    let sibling = itemContainer(item).previousElementSibling;
    while (sibling && !sibling.classList.contains('nav-label')) sibling = sibling.previousElementSibling;
    return sibling ? sibling.dataset.defaultName : 'Menu';
  };
  const updateCounts = () => {
    const inputs = [...options.querySelectorAll('input[type="checkbox"]')];
    const shown = inputs.filter(input => input.checked).length;
    visibleCount.textContent = shown;
    hiddenCount.textContent = inputs.length - shown;
    options.querySelectorAll('.sbc-option').forEach(option => option.classList.toggle('selected', option.querySelector('input').checked));
  };
  const buildOptions = () => {
    const groups = new Map();
    items.forEach(item => {
      const group = groupFor(item);
      if (!groups.has(group)) groups.set(group, []);
      groups.get(group).push(item);
    });
    options.replaceChildren(...[...groups].map(([group, groupItems]) => {
      const section = document.createElement('section');
      section.className = 'sbc-group';
      const title = document.createElement('h3');
      title.className = 'sbc-group-title';
      const groupName = document.createElement('input');
      groupName.className = 'sbc-group-name';
      groupName.dataset.group = group;
      groupName.value = savedNames.groups?.[group] || group;
      groupName.setAttribute('aria-label', `Rename ${group} section`);
      title.appendChild(groupName);
      const grid = document.createElement('div');
      grid.className = 'sbc-grid';
      groupItems.forEach(item => {
        const name = item.querySelector('span').textContent.trim();
        const path = item.getAttribute('href');
        const option = document.createElement('label');
        option.className = 'sbc-option';
        option.draggable = true;
        option.dataset.path = path;
        option.dataset.search = `${group} ${name} ${path}`.toLowerCase();
        const icon = document.createElement('span');
        icon.className = 'sbc-item-icon';
        const sidebarIcon = item.querySelector('svg');
        if (sidebarIcon) icon.appendChild(sidebarIcon.cloneNode(true));
        else icon.textContent = name.split(/\s+/).map(word => word[0]).join('').slice(0, 2).toUpperCase();
        const copy = document.createElement('span');
        copy.className = 'sbc-copy';
        const strong = document.createElement('input');
        strong.className = 'sbc-name-input';
        strong.dataset.path = path;
        strong.value = savedNames.items?.[path] || name;
        strong.setAttribute('aria-label', `Rename ${name}`);
        strong.addEventListener('click', event => event.stopPropagation());
        copy.append(strong);
        const input = document.createElement('input');
        input.type = 'checkbox';
        input.value = path;
        input.checked = !hidden.has(path);
        input.addEventListener('change', updateCounts);
        const toggle = document.createElement('span');
        toggle.className = 'sbc-switch';
        toggle.addEventListener('click', event => {
          event.preventDefault();
          input.checked = !input.checked;
          updateCounts();
        });
        const orderControls = document.createElement('span');
        orderControls.className = 'sbc-order';
        [['↑', 'Move up', -1], ['↓', 'Move down', 1]].forEach(([text, title, direction]) => {
          const button = document.createElement('button');
          button.type = 'button';
          button.textContent = text;
          button.title = title;
          button.setAttribute('aria-label', `${title} ${name}`);
          button.addEventListener('click', event => {
            event.preventDefault();
            const sibling = direction < 0 ? option.previousElementSibling : option.nextElementSibling;
            if (!sibling) return;
            grid.insertBefore(direction < 0 ? option : sibling, direction < 0 ? sibling : option);
          });
          orderControls.appendChild(button);
        });
        option.append(icon, copy, orderControls, input, toggle);
        grid.appendChild(option);
      });
      section.append(title, grid);
      return section;
    }));
    search.value = '';
    updateCounts();
  };
  let draggedOption = null;
  options.addEventListener('dragstart', event => {
    draggedOption = event.target.closest('.sbc-option');
    if (!draggedOption) return;
    draggedOption.classList.add('dragging');
    event.dataTransfer.effectAllowed = 'move';
  });
  options.addEventListener('dragover', event => {
    const target = event.target.closest('.sbc-option');
    if (!draggedOption || !target || target === draggedOption || target.parentElement !== draggedOption.parentElement) return;
    event.preventDefault();
    options.querySelectorAll('.drag-over').forEach(item => item.classList.remove('drag-over'));
    target.classList.add('drag-over');
  });
  options.addEventListener('drop', event => {
    const target = event.target.closest('.sbc-option');
    if (!draggedOption || !target || target.parentElement !== draggedOption.parentElement) return;
    event.preventDefault();
    const box = target.getBoundingClientRect();
    target.parentElement.insertBefore(draggedOption, event.clientY < box.top + box.height / 2 ? target : target.nextSibling);
  });
  options.addEventListener('dragend', () => {
    options.querySelectorAll('.dragging,.drag-over').forEach(item => item.classList.remove('dragging', 'drag-over'));
    draggedOption = null;
  });
  const open = () => {
    buildOptions();
    drawer.classList.add('open');
    backdrop.classList.add('open');
    drawer.setAttribute('aria-hidden', 'false');
    backdrop.setAttribute('aria-hidden', 'false');
    document.body.classList.add('sbc-lock');
    setTimeout(() => search.focus(), 180);
  };
  const close = () => {
    drawer.classList.remove('open');
    backdrop.classList.remove('open');
    drawer.setAttribute('aria-hidden', 'true');
    backdrop.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('sbc-lock');
  };

  trigger.addEventListener('click', open);
  document.getElementById('sbcClose').addEventListener('click', close);
  document.getElementById('sbcCancel').addEventListener('click', close);
  backdrop.addEventListener('click', close);
  document.getElementById('sbcShowAll').addEventListener('click', () => {
    options.querySelectorAll('input[type="checkbox"]').forEach(input => { input.checked = true; });
    updateCounts();
  });
  document.getElementById('sbcHideAll').addEventListener('click', () => {
    options.querySelectorAll('input[type="checkbox"]').forEach(input => { input.checked = false; });
    updateCounts();
  });
  search.addEventListener('input', () => {
    const query = search.value.trim().toLowerCase();
    options.querySelectorAll('.sbc-option').forEach(option => { option.style.display = !query || option.dataset.search.includes(query) ? '' : 'none'; });
    options.querySelectorAll('.sbc-group').forEach(group => {
      group.style.display = [...group.querySelectorAll('.sbc-option')].some(option => option.style.display !== 'none') ? '' : 'none';
    });
  });
  document.getElementById('sbcSave').addEventListener('click', () => {
    hidden = new Set([...options.querySelectorAll('input[type="checkbox"]:not(:checked)')].map(input => input.value));
    savedOrder = [...options.querySelectorAll('.sbc-option')].map(option => option.dataset.path);
    savedNames = {
      items: Object.fromEntries([...options.querySelectorAll('.sbc-name-input')].map(input => [input.dataset.path, input.value.trim() || items.find(item => item.getAttribute('href') === input.dataset.path)?.dataset.defaultName])),
      groups: Object.fromEntries([...options.querySelectorAll('.sbc-group-name')].map(input => [input.dataset.group, input.value.trim() || input.dataset.group]))
    };
    localStorage.setItem(storageKey, JSON.stringify([...hidden]));
    localStorage.setItem(orderKey, JSON.stringify(savedOrder));
    localStorage.setItem(renameKey, JSON.stringify(savedNames));
    applySaved();
    close();
  });
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && drawer.classList.contains('open')) close();
  });
  // ponytail: browser-local per-user settings; move to User only when cross-device sync is required.
  applySaved();
})();
</script>
<% } %>
