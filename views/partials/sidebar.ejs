      <% if (modules?.leads !== false) { %>
      <a href="/counsellor/leads" class="nav-item <%= page === 'leads' ? 'active' : '' %>">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
        <span>All Leads</span>
        <% if (typeof leadCount !== 'undefined' && leadCount > 0) { %>
          <span class="badge badge-gold" style="margin-left: auto; font-size: 10px; font-weight: 700; padding: 1px 5px;"><%= leadCount %></span>
        <% } %>
      </a>
      <a href="/counsellor/leads/new" class="nav-item <%= page === 'leads-new' ? 'active' : '' %>">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        <span>Add Lead</span>
      </a>
      <a href="/counsellor/leads/followups" class="nav-item <%= page === 'followups' ? 'active' : '' %>">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        <span>Follow-ups</span>
        <% if (typeof followupCount !== 'undefined' && followupCount > 0) { %>
          <span class="badge badge-gold" style="margin-left: auto; font-size: 10px; font-weight: 700; padding: 1px 5px;"><%= followupCount %></span>
        <% } %>
      </a>
      <% } %>
      <div class="nav-label">Admissions</div>
      <% if (modules?.students !== false) { %>
      <a href="/counsellor/students" class="nav-item <%= page === 'my-students' ? 'active' : '' %>">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
        <span>My Students</span>
        <% if (typeof studentCount !== 'undefined' && studentCount > 0) { %>
          <span class="badge badge-gold" style="margin-left: auto; font-size: 10px; font-weight: 700; padding: 1px 5px;"><%= studentCount %></span>
        <% } %>
      </a>
      <% } %>
      <% if (modules?.students !== false) { %>
      <a href="/counsellor/admissions" class="nav-item <%= page === 'admissions' ? 'active' : '' %>">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        <span>Pipeline Admissions</span>
      </a>
      <% } %>
      <% if (modules?.leaves !== false) { %>
      <a href="/counsellor/leaves" class="nav-item <%= page === 'leaves' ? 'active' : '' %>">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        <span>Leave Requests</span>
      </a>
      <% } %>
      <% if (modules?.announcements !== false) { %>
      <a href="/counsellor/announcements" class="nav-item <%= page === 'counsellor-announcements' ? 'active' : '' %>">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
        <span>Announcements</span>
